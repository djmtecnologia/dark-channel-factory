# ============================================================
# Dark Channel Factory — Environment Variables Template
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA commite o arquivo .env no git!
# ============================================================

# ── LLM Providers ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Modelo preferencial (cascade automático se indisponível)
# Opções: gemini-2.5-flash-preview-04-17, gemini-2.0-flash, gemini-1.5-flash
LLM_PRIMARY_MODEL=gemini-2.5-flash-preview-04-17
LLM_FALLBACK_MODEL=gemini-1.5-flash
LLM_FINAL_FALLBACK=gpt-4o-mini

# ── Google / YouTube ──────────────────────────────────────
# Obtido via: python setup_auth.py
# Conta: derikmoretti@gmail.com
YOUTUBE_CLIENT_SECRETS_FILE=credentials/client_secrets.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json

# YouTube Data API v3 — para search/trends (API Key pública)
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Media Assets APIs ─────────────────────────────────────
# Pexels (free: 200 req/hora, 20k/mês) — https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay (free: 3400 req/hora) — https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# ── Affiliate Programs ────────────────────────────────────
# Amazon Associates — https://affiliate-program.amazon.com/
AMAZON_AFFILIATE_TAG=yourtag-20

# ClickBank — your affiliate nickname
CLICKBANK_AFFILIATE_ID=your_clickbank_id

# Hotmart — seu perfil de afiliado
HOTMART_AFFILIATE_CODE=your_hotmart_code

# ── Links de Afiliados Fixos por Idioma do Canal (Prioridade Máxima) ──
# Adicione seus links abaixo. Se configurados, eles substituem as buscas dinâmicas por IA.
# AFFILIATE_LINK_EN_US=🔥 Scale Your Business with AI: https://www.amazon.com/dp/1492041130/?tag=canaldarkdjm-20
# AFFILIATE_LINK_ES_ES=🔥 Herramienta de IA Recomendada: https://adaptichat.com/#aff=AIBusinessDK
# AFFILIATE_LINK_FR_FR=Meilleur Livre IA: https://www.amazon.fr/dp/B0FY7KYPGH?tag=canaldarkdjm-20
# AFFILIATE_LINK_DE_DE=KI-System Empfehlung: https://aifluencersystem.de/start#aff=AIBusinessDK


# ── Canal Configuration ───────────────────────────────────
# Nicho primário (scout agent usará como seed)
# Opções: ai_tools, personal_finance, business_automation, health_wellness, real_estate
PRIMARY_NICHE=ai_tools

# Idioma e voz neural (edge-tts)
TARGET_LANGUAGE=en-US
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+15%
TTS_VOLUME=+10%

# Frequência de publicação (dias da semana: monday,tuesday,...,sunday)
PUBLISH_DAYS=tuesday,thursday,saturday
PUBLISH_TIME_UTC=14:00

# ── Pipeline Settings ─────────────────────────────────────
# Resolução do vídeo final
VIDEO_RESOLUTION=1920x1080
VIDEO_FPS=30
VIDEO_BITRATE=4000k

# Duração alvo dos vídeos em segundos
VIDEO_TARGET_DURATION=480

# Minimax de cenas por vídeo
MIN_SCENES=6
MAX_SCENES=12

# Gerar N thumbnails para A/B test
THUMBNAIL_VARIANTS=3

# ── Monitoring ────────────────────────────────────────────
# CTR mínimo aceitável (%) antes de trocar thumbnail
CTR_THRESHOLD_PERCENT=4.0

# Retenção média mínima (%) para disparar deep dive
RETENTION_THRESHOLD_PERCENT=45.0

# Intervalo de verificação de analytics (horas)
ANALYTICS_CHECK_INTERVAL_HOURS=48

# ── Paths ─────────────────────────────────────────────────
OUTPUT_DIR=output
LOGS_DIR=output/logs
VIDEOS_DIR=output/videos
THUMBNAILS_DIR=output/thumbnails
AUDIO_DIR=output/audio
ASSETS_DIR=channel_setup/assets

# ── Dev / Debug ───────────────────────────────────────────
LOG_LEVEL=INFO
DRY_RUN=false
SKIP_UPLOAD=false
MOCK_LLM=false

# ── FinOps / Cost Optimization Settings ───────────────────
# Ativa ou desativa a geração de imagens paga da API do Gemini (Imagen 4.0 - $0.03/imagem)
ENABLE_GEMINI_IMAGEN=false

# Ativa ou desativa as chamadas da LLM para fazer bridging de tendências (Google Trends para nicho do canal)
ENABLE_AI_BRIDGING=false
